// Исходные данные
A1 = 10;
A2 = 20;
A3 = 30;

// Арифметические операции
B1 = A1 + A2;
B2 = A2 - A1;
B3 = A1 * A2;
B4 = A2 / A1;
B5 = A3 % 7;

// Встроенные функции
C1 = SUM(A1:A3);
C2 = AVG(A1:A3);
C3 = MIN(A1:A3);
C4 = MAX(A1:A3);
C5 = IF(A1 < A2, "Yes", "No");

// Копирование формул
fill D1:D3 = A1 * 2;

// Абсолютная ссылка
fill E1:E3 = A1 * $A$1;

// Экспорт
export "result.csv";