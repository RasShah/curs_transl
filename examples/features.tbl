/* Числа, строки, логические значения, диапазоны и функции */
A1 = 2;
A2 = 4;
B1 = "Цена, руб.";
B2 = 'Строка с "кавычками"';
C1 = true;
C2 = A1 < A2;
D1 = SUM(A1:A2, 3);
D2 = AVG(A1:A2);
E1 = MIN(A1:A2, -1);
E2 = MAX(A1:A2, 8);
F1 = IF(C1, "да", "нет");
F2 = IF(false, 1 / 0, (A2 + A1) * 2);
G1 = "Итог: " + "готово";
G2 = 1.5e2 + .5 - 2.; // 148.5
export "features.csv";
